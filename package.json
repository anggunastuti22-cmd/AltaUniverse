{
  "name": "alta-universe",
  "version": "0.0.0",
  "private": true,
  "description": "Alta Universe — personal intelligence and lifestyle ecosystem (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:web": "pnpm --filter @alta/web dev",
    "dev:admin": "pnpm --filter @alta/admin dev",
    "dev:mobile": "pnpm --filter @alta/mobile start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/database/src/types.gen.ts",
    "db:types:local": "node scripts/generate-db-types.mjs > packages/database/src/types.gen.ts",
    "db:test:local": "bash supabase/tests/run-local.sh",
    "clean": "git clean -xdf node_modules .turbo **/.next **/.turbo **/node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vitest": "^3.2.0"
  }
}
