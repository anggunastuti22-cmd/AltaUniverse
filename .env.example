# Alta Universe — root / tooling environment (example)
# Copy to .env (git-ignored) only if a tool needs it. NEVER commit real values.
#
# Per-app variables live in apps/*/.env.example. This file is for repo-level
# tooling such as the Supabase CLI and Edge Functions.

# Server-only Supabase keys (NEVER shipped to any client bundle).
# For the LOCAL stack, `supabase start` prints the anon (publishable) and
# service_role (secret) keys — use those locally.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=your-server-only-service-role-key

# Skip env validation in build/CI steps that lack real values.
# SKIP_ENV_VALIDATION=1
