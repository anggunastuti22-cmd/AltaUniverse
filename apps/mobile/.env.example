# Alta Universe — mobile app environment (example)
# Copy to .env.local and fill in. NEVER commit real values.

# Only EXPO_PUBLIC_* values reach the client bundle. Publishable key ONLY.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-publishable-key

# Set to 1 to skip env validation during builds without real values.
# SKIP_ENV_VALIDATION=1
