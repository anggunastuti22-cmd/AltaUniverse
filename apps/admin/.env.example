# Alta Universe — admin (operator) console environment (example)
# Copy to .env.local and fill in. NEVER commit real values.

# Client-safe (publishable key ONLY). The admin app must never receive a key
# that bypasses RLS on private user tables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-publishable-key

# Set to 1 to skip env validation during builds without real values.
# SKIP_ENV_VALIDATION=1
