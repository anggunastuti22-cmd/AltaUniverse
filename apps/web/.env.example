# Alta Universe — web app environment (example)
# Copy to .env.local and fill in. NEVER commit real values.

# Client-safe (shipped to the browser): publishable key ONLY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-publishable-key

# Server-only (NEVER prefixed with NEXT_PUBLIC, never sent to the client).
# Not required for the foundation phase; uncomment when server features need it.
# SUPABASE_SECRET_KEY=your-server-only-secret-key

# Set to 1 to skip env validation during builds without real values.
# SKIP_ENV_VALIDATION=1
